---
import BaseLayout from '../layouts/BaseLayout.astro';
import { USERS, USER_LABELS } from '../lib/config.js';
---

<BaseLayout title="Anime Tracker">
  <div class="container">
    <!-- App Header -->
    <header class="app-header">
      <div class="app-title-group">
        <span class="app-title">Anime Tracker</span>
      </div>
      <div class="app-header-actions">
        <button class="btn-header-icon" id="btn-random" aria-label="Zufalls-Anime" title="Zufälligen Anime anzeigen">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
            <path d="M10.362 1.093a.75.75 0 00-.724 0l-4 2.25a.75.75 0 00-.388.66v4.5a.75.75 0 00.388.66l4 2.25a.75.75 0 00.724 0l4-2.25a.75.75 0 00.388-.66v-4.5a.75.75 0 00-.388-.66l-4-2.25zM4.75 10.5a.75.75 0 00-.388.66v4.5a.75.75 0 00.388.66l4 2.25a.75.75 0 00.724 0l4-2.25a.75.75 0 00.388-.66v-4.5a.75.75 0 00-.388-.66l-4-2.25a.75.75 0 00-.724 0l-4 2.25z"/>
          </svg>
        </button>
        <button class="btn-header-icon" id="btn-export" aria-label="Exportieren" title="Sammlung exportieren">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
            <path d="M10.75 2.75a.75.75 0 00-1.5 0v8.614L6.295 8.235a.75.75 0 10-1.09 1.03l4.25 4.5a.75.75 0 001.09 0l4.25-4.5a.75.75 0 00-1.09-1.03l-2.955 3.129V2.75z"/>
            <path d="M3.5 12.75a.75.75 0 00-1.5 0v2.5A2.75 2.75 0 004.75 18h10.5A2.75 2.75 0 0018 15.25v-2.5a.75.75 0 00-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5z"/>
          </svg>
        </button>
      </div>
    </header>

    <!-- Stats (horizontal scroll on mobile) -->
    <div class="stats-scroll" id="stats">
      <div class="stat-card stat-total">
        <span class="stat-card-number" id="total-count">0</span>
        <span class="stat-card-label">Gesamt</span>
      </div>
      <div class="stat-card stat-both">
        <span class="stat-card-number" id="both-count">0</span>
        <span class="stat-card-label">Gemeinsam</span>
      </div>
      {USERS.map(user => (
        <div class={`stat-card stat-${user}`}>
          <span class="stat-card-number" id={`${user}-count`}>0</span>
          <span class="stat-card-label">{USER_LABELS[user]}</span>
        </div>
      ))}
    </div>

    <!-- Filter Summary — Mobile: tap to open bottom sheet -->
    <div class="filter-summary" id="filter-summary">
      <span class="filter-summary-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
          <path fill-rule="evenodd" d="M2 3.75A.75.75 0 012.75 3h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 3.75zm0 4.167a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75a.75.75 0 01-.75-.75zm0 4.166a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75a.75.75 0 01-.75-.75zm0 4.167a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75a.75.75 0 01-.75-.75z" clip-rule="evenodd"/>
        </svg>
      </span>
      <span class="filter-summary-text">Filter</span>
    </div>

    <!-- Desktop Filter Bar (hidden on mobile) -->
    <div id="filter-desktop-bar" class="filter-desktop-bar"></div>

    <!-- Anime Grid -->
    <div id="anime-grid" class="anime-grid">
      <div class="anime-grid-loader">
        <div class="loader-spinner"></div>
        <p class="loader-text">Animes werden geladen…</p>
      </div>
    </div>
  </div>

  <!-- FAB — Mobile only (hidden on desktop via CSS) -->
  <button class="fab" id="btn-add-anime" aria-label="Anime hinzufügen">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="22" height="22">
      <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z"/>
    </svg>
  </button>

  <!-- Filter Bottom Sheet Container -->
  <div id="filter-sheet-container"></div>

  <!-- Search Modal Container -->
  <div id="search-modal-container"></div>

  <!-- Debug Panel (einklagpbar) -->
  <details id="boot-debug-wrapper" style="margin-top:16px;display:none;">
    <summary style="cursor:pointer;color:var(--color-muted-foreground);font-size:0.8rem;padding:8px;background:var(--color-card);border:1px solid var(--color-border);border-radius:8px;user-select:none;">
      🐛 Debug-Log
    </summary>
    <div id="boot-debug" style="background:#1a1a2e;border:1px solid #e94560;border-radius:0 0 8px 8px;padding:8px;font-family:monospace;font-size:12px;max-height:300px;overflow-y:auto;border-top:0;"></div>
  </details>

  <script>
    import { bootstrap } from '../lib/bootstrap.js';
    bootstrap().catch(err => console.error('Bootstrap failed:', err));
  </script>
</BaseLayout>
