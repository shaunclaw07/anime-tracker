---
import '../styles/global.css';

export interface Props {
  title?: string;
}

const { title = 'Anime Tracker' } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Anime Tracker — Unsere gemeinsame Anime-Sammlung" />
    <meta name="theme-color" content="#7C3AED" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/anime-tracker/manifest.json" />
    <link rel="apple-touch-icon" href="/anime-tracker/icons/icon-192.svg" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/anime-tracker/sw.js').then(reg => {
    // Neuer SW gefunden? → sofort aktivieren + Seite neuladen
    reg.addEventListener('updatefound', () => {
      const newSW = reg.installing;
      newSW.addEventListener('statechange', () => {
        if (newSW.state === 'installed' && navigator.serviceWorker.controller) {
          newSW.postMessage({ type: 'SKIP_WAITING' });
        }
      });
    });
  });
  // SW hat die Kontrolle übernommen → Seite frisch laden
  let refreshing = false;
  navigator.serviceWorker.addEventListener('controllerchange', () => {
    if (!refreshing) { refreshing = true; window.location.reload(); }
  });
}
</script>
  </body>
</html>
