---
<!--
  AnimeCard — CSS-Only Structure
  The actual HTML rendering is done client-side by JS.
  All styling classes are defined here so they're available at runtime.
-->
---

<!-- Template slot for JS-rendered cards -->
<div id="anime-card-template" aria-hidden="true" style="display:none;"></div>

<style>
  /* ==========================================
     Anime Card — Compact Mobile-First
     Classes match what templates.js generates
     ========================================== */

  .anime-card {
    display: flex;
    flex-direction: column;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .anime-card:active {
    border-color: var(--color-primary);
  }

  .anime-cover,
  .anime-card-cover {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    background: var(--color-muted);
  }

  .anime-cover-placeholder,
  .anime-card-cover-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-muted);
    color: var(--color-muted-foreground);
  }

  .anime-card-body,
  .anime-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2);
    flex: 1;
  }

  .anime-card-title,
  .anime-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-card-foreground);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .anime-card-title-de,
  .anime-title-de {
    font-size: 0.75rem;
    color: var(--color-secondary);
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .anime-card-genres,
  .anime-genres {
    display: none;
  }

  @media (min-width: 640px) {
    .anime-card-genres,
    .anime-genres {
      display: flex;
      flex-wrap: wrap;
      gap: 3px;
    }
  }

  .anime-card-meta,
  .anime-meta {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) 0;
    flex-wrap: wrap;
  }

  .anime-card-actions,
  .anime-actions {
    display: flex;
    gap: 2px;
    padding: var(--space-1) 0;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .anime-card:hover .anime-card-actions,
  .anime-card:active .anime-card-actions,
  .anime-card:hover .anime-actions,
  .anime-card:active .anime-actions {
    opacity: 1;
  }

  /* Score */
  .anime-score {
    font-weight: 700;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .score-high { color: var(--color-success); }
  .score-mid { color: var(--color-warning); }
  .score-low { color: var(--color-muted-foreground); }

  /* Genre Tags */
  .genre-tag {
    display: inline-block;
    background: var(--color-muted);
    color: var(--color-muted-foreground);
    font-size: 0.65rem;
    font-weight: 500;
    padding: 1px 6px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  /* Episodes & Format */
  .anime-episodes {
    font-size: 0.7rem;
    color: var(--color-muted-foreground);
  }

  .anime-format {
    font-size: 0.65rem;
    color: var(--color-secondary);
    background: rgba(167, 139, 250, 0.12);
    padding: 1px 6px;
    border-radius: 4px;
    font-weight: 600;
  }

  /* Watched Badges */
  .watched-badges {
    display: flex;
    gap: 3px;
  }

  .watched-badge {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 0.6rem;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .badge-both {
    background: rgba(244, 63, 94, 0.15);
    color: var(--color-accent);
    border: 1px solid rgba(244, 63, 94, 0.25);
  }

  .badge-chrischi {
    background: rgba(167, 139, 250, 0.15);
    color: var(--color-secondary);
    border: 1px solid rgba(167, 139, 250, 0.25);
  }

  .badge-michelle {
    background: rgba(34, 197, 94, 0.15);
    color: var(--color-success);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  /* Personal Ratings (Stars) */
  .personal-ratings {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    flex-wrap: wrap;
  }

  .personal-rating {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 0.7rem;
    color: var(--color-muted-foreground);
  }

  .rating-name {
    font-weight: 500;
  }

  .star {
    color: #F59E0B;
    font-size: 0.75rem;
  }

  .star-empty {
    color: var(--color-muted-foreground);
    opacity: 0.3;
    font-size: 0.75rem;
  }

  /* Action Buttons (compact) */
  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--touch-min);
    min-height: var(--touch-min);
    background: transparent;
    color: var(--color-muted-foreground);
    border-radius: var(--radius-sm);
    transition: background 0.2s ease, color 0.2s ease;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
  }

  .btn-icon:hover,
  .btn-icon:active {
    background: var(--color-muted);
    color: var(--color-card-foreground);
  }

  .btn-icon-sm {
    min-width: 32px;
    min-height: 32px;
    padding: 4px;
  }
</style>
