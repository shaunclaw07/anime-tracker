---
---

<div id="stats-header" class="stats-header">
  <div class="stats-cards">
    <div class="stat stat-total">
      <span class="stat-number" id="total-count">0</span>
      <span class="stat-label">Gesamt</span>
    </div>
    <div class="stat stat-both">
      <span class="stat-number" id="both-count">0</span>
      <span class="stat-label">Gemeinsam</span>
    </div>
    <div class="stat stat-chrischi">
      <span class="stat-number" id="chrischi-count">0</span>
      <span class="stat-label">Chrischi</span>
    </div>
    <div class="stat stat-michelle">
      <span class="stat-number" id="michelle-count">0</span>
      <span class="stat-label">Michelle</span>
    </div>
  </div>
  <button id="btn-export" class="btn-export" title="Sammlung als JSON exportieren">💾 Export JSON</button>
</div>

<style>
  .stats-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    flex-wrap: wrap;
  }

  .stats-cards {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 28px;
    min-width: 100px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .stat:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--accent);
  }

  .stat-total .stat-number {
    color: var(--accent);
  }

  .stat-both .stat-number {
    color: var(--accent-purple);
  }

  .stat-chrischi .stat-number {
    color: var(--accent-blue);
  }

  .stat-michelle .stat-number {
    color: var(--accent-green);
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 4px;
    font-weight: 500;
  }

  .btn-export {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 20px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .btn-export:hover {
    background: var(--bg-hover);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
</style>
