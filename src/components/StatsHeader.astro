---
<!--
  StatsHeader — CSS for Stats Cards
  Rendered client-side by JS.
-->
---

<div id="stats-header-placeholder" aria-hidden="true" style="display:none;"></div>

<style>
  .stats-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overflow-y: hidden;
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2) 0 var(--space-4);
    scrollbar-width: none;
  }

  .stats-scroll::-webkit-scrollbar {
    display: none;
  }

  .stat-card {
    flex-shrink: 0;
    min-width: 80px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    text-align: center;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .stat-card:active {
    transform: scale(0.96);
  }

  .stat-card-number {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .stat-card-label {
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
    font-weight: 500;
    margin-top: var(--space-1);
  }

  .stat-total .stat-card-number { color: var(--color-primary); }
  .stat-both .stat-card-number { color: var(--color-accent); }
  .stat-chrischi .stat-card-number { color: var(--color-secondary); }
  .stat-michelle .stat-card-number { color: var(--color-success); }
</style>
