---
<!--
  FilterBar — CSS for Filter Bottom Sheet & Desktop Bar
  Rendered client-side by JS.
-->
---

<div id="filter-bar-placeholder" aria-hidden="true" style="display:none;"></div>

<style>
  /* ==========================================
     Filter Summary (Mobile: tap to open)
     ========================================== */
  .filter-summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    margin-bottom: var(--space-4);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
    min-height: var(--touch-min);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .filter-summary:active {
    background: var(--color-muted);
    border-color: var(--color-primary);
  }

  .filter-summary-icon {
    display: flex;
    align-items: center;
    color: var(--color-primary);
  }

  .filter-summary-text {
    flex: 1;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-muted-foreground);
  }

  .filter-summary-active {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    padding: 2px 8px;
    background: rgba(244, 63, 94, 0.1);
    border-radius: var(--radius-full);
  }

  .filter-summary-reset {
    font-size: 0.75rem;
    color: var(--color-primary);
    font-weight: 600;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    transition: background 0.2s ease;
  }

  .filter-summary-reset:active {
    background: rgba(124, 58, 237, 0.15);
  }

  @media (min-width: 640px) {
    .filter-summary {
      display: none;
    }
  }

  /* ==========================================
     Desktop Filter Bar
     ========================================== */
  .filter-desktop-bar {
    display: none;
  }

  @media (min-width: 640px) {
    .filter-desktop-bar {
      display: block;
      background: var(--color-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: var(--space-4);
      margin-bottom: var(--space-4);
    }

    .filter-desktop-inner {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      align-items: flex-start;
    }

    .filter-desktop-section {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      flex: 1;
      min-width: 160px;
    }
  }

  /* ==========================================
     Filter Sheet / Panel (Mobile Bottom Sheet)
     ========================================== */
  .filter-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 150;
    animation: fadeIn 0.2s ease;
  }

  .filter-panel {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--color-card);
    border-radius: 16px 16px 0 0;
    padding: var(--space-5);
    max-height: 75vh;
    overflow-y: auto;
    z-index: 151;
    animation: slideUp 0.3s ease;
  }

  .filter-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .filter-panel-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .filter-panel-close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: var(--touch-min);
    min-height: var(--touch-min);
    color: var(--color-muted-foreground);
    transition: color 0.2s ease;
  }

  .filter-panel-close:active {
    color: var(--color-foreground);
  }

  .filter-panel-section {
    margin-bottom: var(--space-5);
  }

  .filter-panel-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--space-2);
    display: block;
  }

  /* Genre Tags in Filter */
  .filter-genre-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-genre-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    background: var(--color-muted);
    color: var(--color-muted-foreground);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: var(--touch-min);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .filter-genre-tag:active {
    transform: scale(0.96);
  }

  .filter-genre-tag.active {
    background: rgba(124, 58, 237, 0.2);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Score Range */
  .filter-range-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .filter-range {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    height: 6px;
    background: var(--color-muted);
    border-radius: 3px;
    outline: none;
    cursor: pointer;
  }

  .filter-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    background: var(--color-primary);
    border-radius: 50%;
    border: 2px solid var(--color-card);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .filter-range::-webkit-slider-thumb:active {
    transform: scale(1.2);
  }

  .filter-range::-moz-range-thumb {
    width: 22px;
    height: 22px;
    background: var(--color-primary);
    border-radius: 50%;
    border: 2px solid var(--color-card);
    cursor: pointer;
  }

  .filter-range::-moz-range-track {
    height: 6px;
    background: var(--color-muted);
    border-radius: 3px;
  }

  .filter-range-value {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    min-width: 32px;
    text-align: center;
  }

  /* Who Toggle */
  .filter-who-toggle {
    display: flex;
    gap: var(--space-2);
  }

  .filter-who-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-4);
    background: var(--color-muted);
    color: var(--color-muted-foreground);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: var(--touch-min);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .filter-who-btn:active {
    transform: scale(0.96);
  }

  .filter-who-btn.active {
    background: rgba(244, 63, 94, 0.15);
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Filter Actions */
  .filter-actions {
    display: flex;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    min-height: var(--touch-min);
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease;
  }

  .filter-btn:active {
    transform: scale(0.96);
  }

  .filter-btn-primary {
    flex: 1;
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .filter-btn-primary:active {
    background: #6D28D9;
  }

  .filter-btn-secondary {
    background: var(--color-muted);
    color: var(--color-muted-foreground);
    border: 1px solid var(--color-border);
  }

  .filter-btn-secondary:active {
    background: var(--color-card);
    color: var(--color-foreground);
  }

  /* Desktop: hide filter sheet */
  @media (min-width: 640px) {
    .filter-overlay,
    .filter-panel {
      display: none;
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
